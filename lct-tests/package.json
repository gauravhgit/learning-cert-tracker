{
  "name": "lct-tests",
  "version": "1.0.0",
  "description": "Playwright test suite for Learning & Certification Tracker",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:chromium": "playwright test --project=chromium",
    "test:report": "playwright show-report",
    "test:dashboard": "playwright test tests/dashboard.spec.ts",
    "test:courses": "playwright test tests/courses.spec.ts",
    "test:certs": "playwright test tests/certs.spec.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  }
}
